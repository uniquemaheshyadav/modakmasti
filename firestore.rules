rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Player profiles (display name, roll ID, campus)
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    // Leaderboard scores for Modak Masti
    match /leaderboard/{entryId} {
      allow read, write: if true;
    }
  }
}
